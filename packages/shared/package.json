{
  "name": "@whizzo/shared",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./progress": {
      "types": "./dist/progress.d.ts",
      "default": "./dist/progress.js"
    },
    "./learners": {
      "types": "./dist/learners.d.ts",
      "default": "./dist/learners.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js"
    },
    "./rich": {
      "types": "./dist/rich/index.d.ts",
      "default": "./dist/rich/index.js"
    },
    "./grading": {
      "types": "./dist/grading.d.ts",
      "default": "./dist/grading.js"
    },
    "./adaptive": {
      "types": "./dist/adaptive.d.ts",
      "default": "./dist/adaptive.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11"
  }
}
