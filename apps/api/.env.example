# Copy to .env for local development. Nothing here is read in production —
# DigitalOcean App Platform injects these from the app spec.

# Copy both from the dashboard's Connect panel; do not construct them. The old
# direct host (db.<ref>.supabase.co) is IPv6-only without the IPv4 add-on and
# fails with ENOTFOUND on most machines.
#
#   DATABASE_URL           -> "Transaction pooler" (6543)
#   MIGRATION_DATABASE_URL -> "Session pooler"     (5432)
#
# They must differ: the migration runner holds a session-scoped advisory lock,
# which transaction pooling cannot keep.
DATABASE_URL=
MIGRATION_DATABASE_URL=

# Project URL. The JWKS used to verify browser tokens is derived from this.
SUPABASE_URL=https://<project-ref>.supabase.co

# Only needed if your project signs JWTs with the legacy shared secret (HS256).
# Newer projects sign asymmetrically and are verified from the JWKS instead.
# Project Settings -> API -> JWT Settings.
SUPABASE_JWT_SECRET=

# Admin key, for minting child sessions. Never reaches the browser.
# Project Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Origins allowed to call the API. Empty in production, where the SPA and the
# API are the same origin behind one App Platform app.
WEB_ORIGINS=http://localhost:5173

PORT=8787
NODE_ENV=development

# Where the app lives. Stripe's return links and the OAuth server behind
# connected apps both need the real public origin. Same-origin in production;
# the Vite dev server locally.
APP_URL=http://localhost:5173

# --- Connected apps (docs/mcp-tutor-spec.md) -----------------------------------
# Signs the tokens the API's own OAuth server issues to Claude and ChatGPT.
# Separate from every Supabase secret on purpose. Absent means the OAuth and
# /mcp routes refuse politely and the rest of the API runs. At least 32 chars:
#   openssl rand -base64 48
MCP_TOKEN_SECRET=
# The public URL of the MCP endpoint, the audience every token is bound to.
# Defaults to APP_URL + /mcp; set it only when the API is reachable somewhere
# other than the app's own origin.
MCP_PUBLIC_URL=
