{
  "name": "whizzo",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @whizzo/web",
    "dev:api": "npm run dev --workspace @whizzo/api",
    "build": "npm run build --workspace @whizzo/shared && npm run build --workspace @whizzo/web && npm run build --workspace @whizzo/api",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "validate:words": "npm run validate:words --workspace @whizzo/web",
    "simulate:adaptive": "npm run simulate:adaptive --workspace @whizzo/web",
    "test": "npm run typecheck && npm run lint && npm run test:unit && npm run validate:words && npm run simulate:adaptive && npm run simulate:ladder && npm run simulate:planner",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:status": "supabase status",
    "local:env": "node scripts/local-env.mjs",
    "dev:all": "concurrently -n api,web -c cyan,magenta \"npm run dev:api\" \"npm run dev\"",
    "test:db": "node scripts/test-db.mjs",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "simulate:ladder": "npm run simulate:ladder --workspace @whizzo/web",
    "simulate:planner": "npm run simulate:planner --workspace @whizzo/web"
  },
  "engines": {
    "node": ">=20 <23"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
