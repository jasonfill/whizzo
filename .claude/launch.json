{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "whizzo-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--workspace", "@whizzo/web"],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--workspace", "@whizzo/web", "--", "--port", "5199", "--strictPort"],
      "port": 5199
    },
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--workspace", "@whizzo/api"],
      "port": 8787
    }
  ]
}
